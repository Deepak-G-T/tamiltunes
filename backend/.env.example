PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here_at_least_32_characters
JWT_EXPIRES_IN=7d
DATABASE_URL=postgresql://postgres:password@localhost:5432/tamiltunes?schema=public
JIOSAAVN_API_URL=https://www.jiosaavn.com/api.php
# Extra allowed origins, comma-separated. "*" is NOT a wildcard; localhost + the project origins are built in.
CORS_ORIGIN=
# VERCEL_TEAM_SLUG=your-team-slug   # required in production (pins the Vercel preview-origin regex)
# TRUST_PROXY=1   # proxy hops in front of the app (default 1 in production, off in dev)
MUSIC_PROVIDER=jiosaavn
ENABLE_EXTERNAL_STREAMS=false

# Optional video lookup (off unless a key AND an allow-list are set; see CLAUDE.md)
# YOUTUBE_API_KEY=
# VIDEO_CHANNEL_ALLOWLIST=UCxxxxxxxxxxxxxxxxxxxxxx,UCyyyyyyyyyyyyyyyyyyyyyy
# YOUTUBE_DAILY_BUDGET=5000
# VIDEO_INDEX_MAX_PAGES=10     # pages of 50 uploads indexed per allow-listed channel (~1 quota unit each); 0 = off
# VIDEO_SEARCH_FALLBACK=true   # after an index miss, spend ~101 units on a per-song search; false = index only
