// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Profile (all optional; username is backfilled by the migration)
  username        String?  @unique
  bio             String?
  location        String?
  avatar          String?  // small data URL, validated server-side; served via /users/:username/avatar
  avatarUpdatedAt DateTime? // non-null = has avatar; also the cache-busting version
  genres          String[] @default([])
  favoriteArtists String[] @default([])
  language        String?
  isPublicProfile Boolean  @default(true)
  showHistory     Boolean  @default(false)
  role            String   @default("user") // user | artist | admin

  playlists        Playlist[]
  favorites        Favorite[]
  listeningHistory ListeningHistory[]
  comments         Comment[]
  commentLikes     CommentLike[]
  reports          Report[]
  playEvents       PlayEvent[]
  speedDialOverrides SpeedDialOverride[]
  queueState       QueueState?
  followers        Follow[]  @relation("Followed")
  following        Follow[]  @relation("Follower")

  @@map("users")
}

model Song {
  id            String   @id
  title         String
  artist        String
  album         String?
  duration      Int      @default(0)
  image         String?
  streamUrl     String?
  isPlayable    Boolean  @default(true)
  licenseNotice String?
  createdAt     DateTime @default(now())

  // Metadata used by the related-songs ranking (filled from the music provider when known)
  composer String?
  singers  String[] @default([])
  movie    String?
  year     Int?
  language String?

  playlistSongs    PlaylistSong[]
  favorites        Favorite[]
  listeningHistory ListeningHistory[]

  @@index([composer])
  @@index([language, year])
  @@map("songs")
}

model Album {
  id        String   @id
  name      String
  artist    String
  image     String?
  year      String?
  createdAt DateTime @default(now())

  @@map("albums")
}

model Artist {
  id        String   @id
  name      String
  image     String?
  role      String?  @default("Artist")
  createdAt DateTime @default(now())

  @@map("artists")
}

model Playlist {
  id          String   @id @default(uuid())
  name        String
  description String?
  userId      String
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs PlaylistSong[]

  @@index([userId])
  @@map("playlists")
}

model PlaylistSong {
  id         String   @id @default(uuid())
  playlistId String
  songId     String
  position   Int      @default(0)
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([playlistId, songId])
  @@index([songId])
  @@map("playlist_songs")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  songId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
  @@index([songId])
  @@map("favorites")
}

model ListeningHistory {
  id        String   @id @default(uuid())
  userId    String
  songId    String
  playedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
  @@index([userId, playedAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("listening_history")
}

// Comments reference songs by plain id (no FK): a song row only exists once
// someone favourites / plays / saves it.
model Comment {
  id            String   @id @default(uuid())
  songId        String
  userId        String
  parentId      String?
  body          String
  timestampSec  Int?
  isPinned      Boolean  @default(false)
  likeCount     Int      @default(0)
  likedByArtist Boolean  @default(false)
  editedAt      DateTime?
  createdAt     DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("Replies")
  likes   CommentLike[]
  reports Report[]

  @@index([songId, createdAt(sort: Desc)])
  @@index([songId, likeCount(sort: Desc)])
  @@index([parentId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("comments")
}

model CommentLike {
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

model Follow {
  followerId String
  followedId String
  createdAt  DateTime @default(now())

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followed User @relation("Followed", fields: [followedId], references: [id], onDelete: Cascade)

  @@id([followerId, followedId])
  @@index([followedId, createdAt(sort: Desc)])
  @@map("follows")
}

model Report {
  id         String   @id @default(uuid())
  commentId  String
  reporterId String
  reason     String
  createdAt  DateTime @default(now())

  comment  Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter User    @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([commentId, reporterId])
  @@map("reports")
}

// What a user actually did with a song: lets the radio learn from completions and skips.
// songId is a plain string (no FK) so events can be recorded for any playable song.
model PlayEvent {
  id           String   @id @default(uuid())
  userId       String
  songId       String
  playedAt     DateTime @default(now())
  completed    Boolean  @default(false)
  skippedAtSec Int?
  source       String?  // radio | search | playlist | album | queue | speed-dial | guest-import
  // Speed Dial: one row per play. A play counts once the user listened 30 s or half the song.
  playId       String?  // client-made id so a later "completed" update hits the same row
  listenedSec  Int?
  durationSec  Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, playId])
  @@index([userId, playedAt(sort: Desc)])
  @@index([songId, playedAt(sort: Desc)])
  @@index([userId, songId, playedAt])
  @@map("play_events")
}

// Per-user changes to the auto-ranked Speed Dial: pinned slots and hidden songs.
model SpeedDialOverride {
  id           String   @id @default(uuid())
  userId       String
  songId       String
  slotPosition Int?     // 0-based slot for a pinned song
  isPinned     Boolean  @default(false)
  isHidden     Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
  @@index([userId])
  @@map("speed_dial_overrides")
}

// The play queue of a signed-in user (one row each). Only song ids are stored; metadata is re-fetched on restore.
model QueueState {
  userId       String   @id @map("user_id")
  items        Json     // [{ id, o }]: history (last 50), the current song, then upcoming; o = u (added by user) | r (radio) | c (list)
  currentIndex Int      @default(-1) @map("current_index")
  positionSec  Int      @default(0) @map("position_sec")
  shuffle      Boolean  @default(false)
  repeat       String   @default("off")
  autoplay     Boolean  @default(true)
  mode         String   @default("radio")
  sourceLabel  String?  @map("source_label")
  deviceId     String?  @map("device_id")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("queue_state")
}
