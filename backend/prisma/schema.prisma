// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Profile (all optional; username is backfilled by the migration)
  username        String?  @unique
  bio             String?
  location        String?
  avatar          String?  // small data URL (WebP/JPEG, validated server-side)
  genres          String[] @default([])
  favoriteArtists String[] @default([])
  language        String?
  isPublicProfile Boolean  @default(true)
  showHistory     Boolean  @default(false)
  role            String   @default("user") // user | artist | admin

  playlists        Playlist[]
  favorites        Favorite[]
  listeningHistory ListeningHistory[]
  comments         Comment[]
  commentLikes     CommentLike[]
  reports          Report[]
  followers        Follow[]  @relation("Followed")
  following        Follow[]  @relation("Follower")

  @@map("users")
}

model Song {
  id            String   @id
  title         String
  artist        String
  album         String?
  duration      Int      @default(0)
  image         String?
  streamUrl     String?
  isPlayable    Boolean  @default(true)
  licenseNotice String?
  createdAt     DateTime @default(now())

  playlistSongs    PlaylistSong[]
  favorites        Favorite[]
  listeningHistory ListeningHistory[]

  @@map("songs")
}

model Album {
  id        String   @id
  name      String
  artist    String
  image     String?
  year      String?
  createdAt DateTime @default(now())

  @@map("albums")
}

model Artist {
  id        String   @id
  name      String
  image     String?
  role      String?  @default("Artist")
  createdAt DateTime @default(now())

  @@map("artists")
}

model Playlist {
  id          String   @id @default(uuid())
  name        String
  description String?
  userId      String
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs PlaylistSong[]

  @@index([userId])
  @@map("playlists")
}

model PlaylistSong {
  id         String   @id @default(uuid())
  playlistId String
  songId     String
  position   Int      @default(0)
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([playlistId, songId])
  @@index([songId])
  @@map("playlist_songs")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  songId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
  @@index([songId])
  @@map("favorites")
}

model ListeningHistory {
  id        String   @id @default(uuid())
  userId    String
  songId    String
  playedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([songId])
  @@index([userId, playedAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("listening_history")
}

// Comments reference songs by plain id (no FK): a song row only exists once
// someone favourites / plays / saves it.
model Comment {
  id            String   @id @default(uuid())
  songId        String
  userId        String
  parentId      String?
  body          String
  timestampSec  Int?
  isPinned      Boolean  @default(false)
  likeCount     Int      @default(0)
  likedByArtist Boolean  @default(false)
  editedAt      DateTime?
  createdAt     DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("Replies")
  likes   CommentLike[]
  reports Report[]

  @@index([songId, createdAt(sort: Desc)])
  @@index([songId, likeCount(sort: Desc)])
  @@index([parentId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("comments")
}

model CommentLike {
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

model Follow {
  followerId String
  followedId String
  createdAt  DateTime @default(now())

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followed User @relation("Followed", fields: [followedId], references: [id], onDelete: Cascade)

  @@id([followerId, followedId])
  @@index([followedId, createdAt(sort: Desc)])
  @@map("follows")
}

model Report {
  id         String   @id @default(uuid())
  commentId  String
  reporterId String
  reason     String
  createdAt  DateTime @default(now())

  comment  Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter User    @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([commentId, reporterId])
  @@map("reports")
}
