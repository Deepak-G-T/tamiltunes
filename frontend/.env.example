# Frontend Environment Variables
# In local development with Vite proxy, leave empty or use /api
VITE_API_BASE_URL=/api

# For production deployment (e.g. Vercel pointing to Render backend)
# VITE_API_BASE_URL=https://tamiltunes-backend.onrender.com/api

# Google sign-in: the WEB client id (a public value). See docs/GOOGLE_SIGNIN.md
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx-xxxxxxxx.apps.googleusercontent.com
