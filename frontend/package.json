{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-jsx-imports.mjs",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vite build && vite build --mode nativetest && node scripts/run-ui-audits.mjs",
    "test:player": "vite build && node scripts/player-audit.mjs",
    "test:queue": "vite build && node scripts/queue-audit.mjs",
    "test:search": "vite build && node scripts/search-audit.mjs",
    "test:auth": "vite build && node scripts/auth-audit.mjs",
    "test:home": "vite build && node scripts/home-audit.mjs",
    "test:pwa": "vite build && node scripts/pwa-audit.mjs",
    "build:android": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "node scripts/android-build.mjs assembleDebug",
    "android:icons": "node scripts/make-icons.mjs && capacitor-assets generate --android --assetPath assets",
    "test:native": "vite build --mode nativetest && node scripts/native-audit.mjs",
    "pwa:screenshots": "vite build && node scripts/make-screenshots.mjs",
    "images": "node scripts/make-icons.mjs && capacitor-assets generate --android --assetPath assets && npm run pwa:screenshots",
    "postinstall": "node -e \"if(require('fs').existsSync('patches')){try{require('child_process').execSync('npx --no-install patch-package',{stdio:'inherit'})}catch(e){console.warn('patch-package skipped:',e.message)}}\""
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-social-login": "8.7.13",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "^11.16.0",
    "@tailwindcss/vite": "^4.3.5",
    "axios": "^1.21.1",
    "capacitor-music-controls-plugin": "^8.0.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.73.0",
    "patch-package": "^8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "oxlint": "^1.90.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
